#!/usr/bin/env bash

set -euo pipefail

if systemctl is-active --quiet opencode-server.service; then
    systemctl restart opencode-server.service
elif mountpoint --quiet /var/lib/opencode_server \
    && grep -q '^OPENCODE_SERVER_PASSWORD=.' /etc/opencode_server/server.env; then
    systemctl start opencode-server.service
fi
