#!/usr/bin/env bash

set -euo pipefail

[[ "$(/usr/local/bin/opencode --version)" == "1.18.31" ]]
[[ "${OPENCODE_SERVER_USERNAME:-}" == "opencode" ]]
[[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]]

# The resolved configuration may contain provider credentials in later
# deployments, so discard it instead of sending it to journald.
/usr/local/bin/opencode debug config >/dev/null
