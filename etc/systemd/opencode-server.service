[Unit]
Description=OpenCode Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/var/lib/opencode_server/workspace
Environment=HOME=/var/lib/opencode_server
Environment=XDG_CONFIG_HOME=/var/lib/opencode_server/config
Environment=XDG_DATA_HOME=/var/lib/opencode_server/data
Environment=XDG_CACHE_HOME=/var/lib/opencode_server/cache
Environment=XDG_STATE_HOME=/var/lib/opencode_server/state
Environment=OPENCODE_CONFIG=/etc/opencode_server/opencode.jsonc
EnvironmentFile=/etc/opencode_server/server.env
ExecStartPre=/usr/local/bin/opencode-server-validate
ExecStart=/usr/local/bin/opencode serve --hostname 0.0.0.0 --port 4096 --log-level INFO --print-logs --pure
Restart=on-failure
RestartSec=2s
TimeoutStartSec=300s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opencode_server
RestrictSUIDSGID=true
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
