name: "opencode_halogen_qwen38"
description: "A ready OpenCode pool for the halogen-qwen3.8 model of the Halogen OpenAI-compatible endpoint."
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.0.0"
  opencode_server:
    from_version: "0.0.0"

resources:

  # The endpoint is not part of the build artifact. Set it after install:
  #   exordos vs vars set opencode_halogen_qwen38_base_url https://<host>/v1
  # The pool picks the new value up on the next reconciliation.
  $core.vs.variables:
    base_url:
      name: "opencode_halogen_qwen38_base_url"
      description: "Base URL of the Halogen OpenAI-compatible API"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      setter:
        kind: selector
        selector_strategy: latest

  # `description` carries the EM project id: the metapaas core-agent syncs
  # only the pools marked with it. `image` is a copy of the version's
  # image: a new release of opencode_server updates it in place, and EM
  # re-renders the pool, which replaces its free workers.
  $opencode_server.types.opencode.pools:
    halogen_qwen38:
      name: "halogen_qwen38"
      description: "12345678-c625-4fee-81d5-f691897b8142"
      image: $opencode_halogen_qwen38.imports.$version:image
      cores: 6
      ram: 8192
      hot_size: 1
      opencode_config:
        model: "halogen/halogen-qwen38"
        provider:
          halogen:
            npm: "@ai-sdk/openai-compatible"
            name: "halogen"
            options:
              baseURL: $core.vs.variables.$base_url:value
            models:
              halogen-qwen38:
                name: "halogen-qwen3.8"
                limit:
                  context: 262144
                  output: 65536

imports:
  version:
    element: "$opencode_server"
    kind: "resource"
    link: "$opencode_server.types.opencode.versions.$default"

exports:
  pool:
    link: "$opencode_server.types.opencode.pools.$halogen_qwen38"
