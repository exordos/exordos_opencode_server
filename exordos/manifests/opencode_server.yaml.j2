name: "opencode_server"
description: "Disposable OpenCode build workers served from a hot pool (MetaPaaS plugin)."
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.0.0"
  metapaas:
    from_version: "1.2.0"

resources:

  # Register the opencode PaaS type in metapaas. The metapaas core-agent
  # reconciles it into metapaas_paas_types; the PluginReconciler then
  # installs the package, applies its migrations and restarts the services.
  $metapaas.types:
    opencode:
      name: "opencode"
      element_name: "opencode_server"
      package: "{{ artifacts.pypi_package }}"
      project_id: "4d657461-0000-0000-0000-000000000002"

  # Permission names must match the API controllers:
  # exordos_opencode_server.<policy>.<action>.
  $core.iam.permissions:
    version_read:
      name: "exordos_opencode_server.version.read"
    pool_create:
      name: "exordos_opencode_server.pool.create"
    pool_read:
      name: "exordos_opencode_server.pool.read"
    pool_update:
      name: "exordos_opencode_server.pool.update"
    pool_delete:
      name: "exordos_opencode_server.pool.delete"
    pool_purge_idle:
      name: "exordos_opencode_server.pool.purge_idle"
    worker_read:
      name: "exordos_opencode_server.worker.read"
    lease_create:
      name: "exordos_opencode_server.lease.create"
    lease_read:
      name: "exordos_opencode_server.lease.read"
    lease_delete:
      name: "exordos_opencode_server.lease.delete"
    lease_release:
      name: "exordos_opencode_server.lease.release"

  # A permission bound to a role is granted wherever the role is: Core
  # does not scope permission bindings by project. So nothing here is
  # bound to the owner role, which every project owner holds - that would
  # let any of them administer the global pools. The element brings its
  # own roles instead, granted to a user in a project by a role binding.
  $core.iam.roles:
    # Everything about pools, workers and leases.
    opencode_admin:
      name: "opencode_admin"
      description: "Administer OpenCode pools, workers and leases"
    # What a client needs: find a pool and order workers from it. Leases
    # are project resources, so a client binds its user to this role in
    # the project its leases belong to (see exports).
    opencode_lease_client:
      name: "opencode_lease_client"
      description: "Order OpenCode workers (leases) from the pools"
    # The infra agent manages client keys as Core SSH keys
    # (/v1/secret/ssh_keys/) as the metapaas user, and the Core owner role
    # does not carry secret.ssh_key.*.
    opencode_infra:
      name: "opencode_infra"
      description: "Manage the Core SSH keys of OpenCode workers"

  # Permission names must match the API controllers.
  $core.iam.permissionbinding:
    admin_version_read_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$version_read:uuid
    admin_pool_create_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$pool_create:uuid
    admin_pool_read_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$pool_read:uuid
    admin_pool_update_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$pool_update:uuid
    admin_pool_delete_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$pool_delete:uuid
    admin_pool_purge_idle_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$pool_purge_idle:uuid
    admin_worker_read_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$worker_read:uuid
    admin_lease_create_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$lease_create:uuid
    admin_lease_read_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$lease_read:uuid
    admin_lease_delete_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$lease_delete:uuid
    admin_lease_release_binding:
      role: $core.iam.roles.$opencode_admin:uuid
      permission: $core.iam.permissions.$lease_release:uuid
    client_version_read_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$version_read:uuid
    client_pool_read_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$pool_read:uuid
    client_lease_create_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$lease_create:uuid
    client_lease_read_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$lease_read:uuid
    client_lease_delete_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$lease_delete:uuid
    client_lease_release_binding:
      role: $core.iam.roles.$opencode_lease_client:uuid
      permission: $core.iam.permissions.$lease_release:uuid
    # Core's own permissions, by their fixed UUIDs (exordos_core
    # core.yaml.j2).
    infra_core_ssh_key_read_binding:
      role: $core.iam.roles.$opencode_infra:uuid
      permission: "42079bc1-48b3-4ffd-8131-35d1e4e5be05"
    infra_core_ssh_key_create_binding:
      role: $core.iam.roles.$opencode_infra:uuid
      permission: "e491736f-2749-42f7-ad39-bea4362cc38e"
    infra_core_ssh_key_update_binding:
      role: $core.iam.roles.$opencode_infra:uuid
      permission: "de7298aa-45d0-442f-96a2-efc84a40c56d"
    infra_core_ssh_key_delete_binding:
      role: $core.iam.roles.$opencode_infra:uuid
      permission: "23102ef6-c168-4490-8cd1-4b1a6903964b"

  # The metapaas user (fixed in the metapaas manifest) runs the plugin's
  # services, in the metapaas project.
  $core.iam.rolebinding:
    metapaas_opencode_admin:
      role: $core.iam.roles.$opencode_admin:uuid
      user: "4d657461-0000-0000-0000-000000000001"
      project: "4d657461-0000-0000-0000-000000000002"
    metapaas_opencode_infra:
      role: $core.iam.roles.$opencode_infra:uuid
      user: "4d657461-0000-0000-0000-000000000001"
      project: "4d657461-0000-0000-0000-000000000002"

  # The plugin API, served by metapaas behind the Core LB.
  $core.vs.variables:
    opencode_server_endpoint:
      name: "opencode_server_endpoint"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      setter:
        kind: "selector"
        selector_strategy: "latest"

  $core.vs.values:
    opencode_server_endpoint:
      name: "OpenCode Server endpoint"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      read_only: true
      variable: $core.vs.variables.$opencode_server_endpoint:uuid
      value: f"http://{$opencode_server.imports.$core_ip_address:value}/api/metapaas/v1/types/opencode/"

  # The worker image. One stable entry: every release of the element
  # updates its image in place. Manifest pools link its `image`, so EM
  # re-renders them with the new image.
  # `description` carries the EM project id for the core-agent filter
  # (em_opencode_server_types_opencode_versions).
  $opencode_server.types.opencode.versions:
    default:
      name: "default"
      description: "12345678-c625-4fee-81d5-f691897b8142"
      image: "{{ images.opencode_worker }}"

imports:
  core_ip_address:
    element: "$core"
    kind: "resource"
    link: "$core.vs.variables.$core_ip_address"

exports:
  # The plugin API URL.
  endpoint:
    kind: "resource"
    link: "$core.vs.variables.$opencode_server_endpoint"
  version:
    link: "$opencode_server.types.opencode.versions.$default"
  # Bound to a client's user in the client's project.
  lease_client_role:
    link: "$core.iam.roles.$opencode_lease_client"
  # Bound to whoever administers the pools.
  admin_role:
    link: "$core.iam.roles.$opencode_admin"
